[Unit]
Description=RT-DETR Auto Processor Service - 自动切片和推理服务
After=network.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=@PROJECT_ROOT@
ExecStart=@PYTHON_PATH@ @PROJECT_ROOT@/service_main.py --config @PROJECT_ROOT@/config.yaml
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=rtdetr-processor

# 环境变量
Environment="PYTHONUNBUFFERED=1"
Environment="CUDA_VISIBLE_DEVICES=0"

# 资源限制
LimitNOFILE=65536
MemoryMax=16G
CPUQuota=400%

# 安全设置
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
