[Unit]
Description=RT-DETR Auto Processor Service
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/lsn/project_new/RT-DETR-main/DataSlice2Inference/auto_process_package
ExecStart=/usr/bin/python3 /home/ubuntu/lsn/project_new/RT-DETR-main/DataSlice2Inference/auto_process_package/auto_process_monitor.py --config /home/ubuntu/lsn/project_new/RT-DETR-main/DataSlice2Inference/config.yaml
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

# 资源限制
LimitNOFILE=65536
MemoryMax=16G

[Install]
WantedBy=multi-user.target

